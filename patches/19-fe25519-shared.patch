+static inline void
+fe25519_mul(fe25519 h, const fe25519 f, const fe25519 g)
+{
+    sodium_esphome_fe25519_mul(h, f, g);
+}
+
+static inline void
+fe25519_sq(fe25519 h, const fe25519 f)
+{
+    sodium_esphome_fe25519_sq(h, f);
+}
