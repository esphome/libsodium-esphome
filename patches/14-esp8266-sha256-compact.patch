+#ifdef SODIUM_ESPHOME_COMPACT_SHA256
+/* One round per loop pass with the working variables rotated by hand, in
+   place of the 64 unrolled rounds below: about 1.4 KB less flash on the
+   ESP8266. It costs a little per block, and a Noise handshake hashes a few
+   dozen short inputs while the transport hashes nothing, so a connect does
+   not notice. S is unused; the signature stays so the callers do not care
+   which transform they got. */
+static void
+SHA256_Transform(uint32_t state[8], const uint8_t block[64], uint32_t W[64],
+                 uint32_t S[8])
+{
+    uint32_t a, b, c, d, e, f, g, h, t1, t2;
+    int i;
+
+    (void) S;
+    be32dec_vect(W, block, 64);
+    for (i = 16; i < 64; i++) {
+        W[i] = s1(W[i - 2]) + W[i - 7] + s0(W[i - 15]) + W[i - 16];
+    }
+    a = state[0];
+    b = state[1];
+    c = state[2];
+    d = state[3];
+    e = state[4];
+    f = state[5];
+    g = state[6];
+    h = state[7];
+    for (i = 0; i < 64; i++) {
+        t1 = h + S1(e) + Ch(e, f, g) + Krnd[i] + W[i];
+        t2 = S0(a) + Maj(a, b, c);
+        h  = g;
+        g  = f;
+        f  = e;
+        e  = d + t1;
+        d  = c;
+        c  = b;
+        b  = a;
+        a  = t1 + t2;
+    }
+    state[0] += a;
+    state[1] += b;
+    state[2] += c;
+    state[3] += d;
+    state[4] += e;
+    state[5] += f;
+    state[6] += g;
+    state[7] += h;
+}
+#else
 static void
 SHA256_Transform(uint32_t state[8], const uint8_t block[64], uint32_t W[64],
                  uint32_t S[8])
@@ -154,6 +204,7 @@ SHA256_Transform(uint32_t state[8], const uint8_t block[64], uint32_t W[64],
         state[i] += S[i];
     }
 }
