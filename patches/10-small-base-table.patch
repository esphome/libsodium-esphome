+/*
+ ESPHome: base_packed[k][j] holds (j+1)*16^(4k)*B as the 32 byte encodings of
+ y+x, y-x and 2dxy in little endian words, a quarter of the reference table at
+ four fifths of the size per point. The constant time select runs over the
+ words and only the winner is unpacked. Keeping the table small matters on
+ chips that run from flash through a cache of 16 to 32 KB: the reference table
+ is read in full for every window and evicts itself and the code. The table is
+ generated by .github/scripts/gen_base_packed.py from fe_25_5/base.h.
+ */
 static void
 ge25519_cmov8_base(ge25519_precomp *t, const int pos, const signed char b)
 {
 #ifdef ESP8266
 #define GE25519_BASE_ATTR __attribute__((section(".irom.text")))
-// NOTE: no need to use special _P functions because all data in ge25519_precomp
-// is already word-sized
 #else
 #define GE25519_BASE_ATTR
 #endif
     CRYPTO_ALIGN(16)
-    static const ge25519_precomp GE25519_BASE_ATTR base[32][8] = { /* base[i][j] = (j+1)*256^i*B */
-#ifdef HAVE_TI_MODE
-# include "fe_51/base.h"
-#else
-# include "fe_25_5/base.h"
-#endif
+    static const uint32_t GE25519_BASE_ATTR base_packed[16][8][24] = {
+#include "base_packed.h"
     };
-
 #undef GE25519_BASE_ATTR
-    ge25519_cmov8(t, base[pos], b);
+    ge25519_precomp     minust;
+    const unsigned char bnegative = negative(b);
+    const unsigned char babs      = b - (((-bnegative) & b) * ((signed char) 1 << 1));
+    uint32_t            sel[24];
+    unsigned char       bytes[96];
+    int                 i, j;
+
+    /* the identity: y+x = 1, y-x = 1, 2dxy = 0 */
+    memset(sel, 0, sizeof sel);
+    sel[0] = 1;
+    sel[8] = 1;
+    for (j = 0; j < 8; j++) {
+        const uint32_t  mask = (uint32_t) 0 - (uint32_t) equal(babs, (signed char) (j + 1));
+        const uint32_t *row  = base_packed[pos][j];
+
+        for (i = 0; i < 24; i++) {
+            sel[i] ^= mask & (sel[i] ^ row[i]);
+        }
+    }
+    for (i = 0; i < 24; i++) {
+        STORE32_LE(bytes + 4 * i, sel[i]);
+    }
+    fe25519_frombytes(t->yplusx, bytes);
+    fe25519_frombytes(t->yminusx, bytes + 32);
+    fe25519_frombytes(t->xy2d, bytes + 64);
+    fe25519_copy(minust.yplusx, t->yminusx);
+    fe25519_copy(minust.yminusx, t->yplusx);
+    fe25519_neg(minust.xy2d, t->xy2d);
+    ge25519_cmov(t, &minust, bnegative);
 }
 
